# Copy to .env.local only if that file does not already exist.
# Use development credentials. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Server-only values: never prefix these with NEXT_PUBLIC_.
# The Stripe webhook requires a service-role key for its database writes.
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
